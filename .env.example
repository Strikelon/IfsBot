# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Пустые строки с комментарием «необязательно» можно оставить пустыми.

# ===== Telegram =====
# Токен бота от @BotFather — на нём бот работает на сервере.
BOT_TOKEN=
# Необязательно: токен отдельного тестового бота для запуска на своём компьютере.
# Если задан, локально бот и админка работают на нём. На сервер он не уезжает.
BOT_DEV_TOKEN=
# Ваш числовой Telegram ID (узнать: @userinfobot). Только вам доступна команда
# /interview, и сюда же приходит оповещение о дневных тратах.
ADMIN_ID=
# Куда писать человеку, упёршемуся в лимит, — ссылка в тексте пейвола.
SUPPORT_CONTACT_URL=https://t.me/your_username

# ===== База данных =====
# Локально — свой Postgres. На сервере deploy.py пишет эту строку сам из DB_PASSWORD.
DATABASE_URL=postgresql+asyncpg://dream_bot:password@127.0.0.1:5432/dream_bot

# ===== Нейросети =====
# OpenAI — только распознавание голосовых (Whisper).
OPENAI_API_KEY=
# OpenRouter — разборы и все остальные вызовы моделей.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_GENERATOR_MODEL=google/gemini-2.5-pro
OPENROUTER_CLASSIFIER_MODEL=google/gemini-2.5-flash
OPENROUTER_INTENT_MODEL=openai/gpt-4o-mini
OPENROUTER_CONTEXT_MODEL=google/gemini-3.1-flash-lite
# Необязательно: прокси для Telegram, OpenAI и OpenRouter. Нужен, если сервер
# в стране, откуда эти сервисы недоступны (например, в России).
# Формат: http://user:pass@host:port
LLM_PROXY=

# ===== Лимиты трат на нейросеть (в долларах на пользователя) =====
# early_tester — тариф первых тестеров, new — все остальные.
USER_SPEND_LIMIT_USD=1.0
NEW_USER_SPEND_LIMIT_USD=1.0
# Необязательно: ники Telegram без лимита, через запятую (например, владельцы).
SPEND_LIMIT_EXEMPT_USERNAMES=
# Оповещение вам в Telegram, если за сутки все траты превысили сумму.
DAILY_SPEND_ALERT_USD=100

# ===== Админка =====
ADMIN_USERNAME=admin
# Хэш пароля bcrypt. Получить (подставьте свой пароль):
#   python -c "import bcrypt; print(bcrypt.hashpw(b'ваш_пароль', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=
# Любая длинная случайная строка. Получить:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SESSION_SECRET=
# Админка открывается через SSH-туннель по http, поэтому false.
COOKIE_SECURE=false
ADMIN_TZ=Europe/Moscow

# ===== Прочее (можно не трогать) =====
LOG_LEVEL=INFO
MEMORY_WRITE_ENABLED=true
MEMORY_INJECT_ENABLED=true
MEMORY_COMPACT_ENABLED=true
MEMORY_COMPACT_BUDGET_CHARS=2500
# Необязательно: адрес Sentry для отчётов об ошибках.
SENTRY_DSN=

# ===== Сервер — только для deploy/deploy.py =====
SERVER_IP=
SERVER_USER=root
SERVER_SSH_PORT=22
# Вход по ключу (путь к приватному ключу) или по паролю — нужно одно из двух.
SERVER_SSH_KEY=~/.ssh/id_ed25519
SERVER_PASSWORD=
# Пароль, с которым deploy.py создаст пользователя базы на сервере.
DB_PASSWORD=
